use flake

# nix-direnv may cache the dev shell and its shellHook. Run the inexpensive
# staleness check on every direnv activation so the reference is refreshed
# after 24 hours even when the Nix environment itself has not changed.
project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if ! "$project_root/scripts/update-effect-vendor"; then
  log_status "Could not update .vendor/effect; using the existing copy"
fi
unset project_root
